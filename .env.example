# Copy to ~/.config/grok-mcp/.env (chmod 600) and fill in — OUTSIDE WORKSPACE_DIR / ASSETS_DIR:
# the agent's shell can read anything under the mounted directories, and the server refuses to
# start when this file is there. Start with `make up` (another file: make up GROK_CONFIG=...).

# --- Required ----------------------------------------------------------------------------

# xAI API key
XAI_API_KEY=xai-...

# Bearer token clients must send to /mcp (Authorization: Bearer <token>).
# Generate: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Postgres password (used to initialise a new volume and to connect). Any characters work —
# it is passed to the server as PGPASSWORD, not embedded in a URL — but wrap it in single
# quotes if it contains `$`, which compose would expand otherwise.
POSTGRES_PASSWORD=
#POSTGRES_USER=grok

# Host directory mounted into the container at the SAME path, so file paths passed by MCP
# clients resolve 1:1. Only the projects the agent may work on — everything under it is
# readable through `shell`; keep this config file and other secrets elsewhere. Use the real,
# absolute path (no symlink anywhere in it, no trailing slash): Docker mounts a symlink's
# target, which the server's "config outside the mounts" check cannot see, so `make up`
# refuses a WORKSPACE_DIR / ASSETS_DIR whose `realpath -m` differs. Write it literally: compose
# expands `${VAR}` in this file, so `make up` refuses a value containing `$`.
WORKSPACE_DIR=/home/you/projects

# --- Optional ----------------------------------------------------------------------------

# Transport (compose sets these; for running outside Docker): stdio (default) | http
#MCP_TRANSPORT=stdio
#MCP_HTTP_HOST=127.0.0.1         # a non-loopback address requires MCP_AUTH_TOKEN
#MCP_HTTP_PORT=8000

# Extra host directory outside the workspace, mounted at the SAME path
#ASSETS_DIR=/home/you/assets

# Host uid/gid the container runs as (check with `id -u` / `id -g`)
#DOCKER_UID=1000
#DOCKER_GID=1000

# Published addresses (loopback by default — the tools can run shell commands)
#MCP_BIND=127.0.0.1
#MCP_PORT=8000

#POSTGRES_BIND=127.0.0.1
#POSTGRES_PORT=5432

# Container limits for everything the agent's shell runs
#GROK_MEM_LIMIT=4g
#GROK_PIDS_LIMIT=512

# Byte budget per tool call (not per file): summed over all files of one `read` (globs and lists
# included) and over all file_paths + image_paths of one `agent` call. A `read` with offset/limit
# counts only the returned range — it does not raise the cap on the file's size.
#GROK_MAX_READ_BYTES=20000000

# Path allow-lists (comma-separated). The compose file defaults both to WORKSPACE_DIR,ASSETS_DIR;
# outside compose, unset means reads unrestricted (except /proc, /sys, /dev) and writes denied.
#GROK_WRITE_ALLOWED_PATHS=/home/you/projects,/home/you/assets
#GROK_READ_ALLOWED_PATHS=/home/you/projects,/home/you/assets

# --- Logging & retention -----------------------------------------------------------------

# metadata (default): prompts, answers and commands logged as size + keyed hash (HMAC) only
# full: logged whole — for debugging; secrets are masked in both modes
#GROK_LOG_CONTENT=metadata

# Days stored data is kept (0 = forever). Purged at startup and every 24 h.
#GROK_RETENTION_CHAT_DAYS=30           # conversation messages
#GROK_RETENTION_JOB_CONTENT_DAYS=7     # background job result / error text
#GROK_RETENTION_JOBS_DAYS=365          # background job metadata (status, tokens, timing)
#GROK_RETENTION_PROJECTS_DAYS=90       # project discovery entries

# --- agent() limits (defaults shown) -----------------------------------------------------

#GROK_FOREGROUND_TIMEOUT=60      # s; longer foreground calls move to a background job
#GROK_JOB_MAX_SECONDS=1800       # s per run — ceiling: a call can only lower it
#GROK_MAX_COST_USD=2.5           # estimated USD per run — ceiling
#GROK_MAX_ITERATIONS=100         # model rounds per run — ceiling
#GROK_INPUT_MAX_RATIO=0.6        # share of the model's context window
#GROK_TOOL_RESULT_MAX_RATIO=0.15
#GROK_CONTEXT_MAX_RATIO=0.8
#GROK_SHELL_TIMEOUT=240          # s per shell command

# --- Model catalog (optional) ------------------------------------------------------------

#GROK_MODELS_TTL=86400           # s between live model-catalog refreshes
#GROK_CHARS_PER_TOKEN=3.0        # token estimate for text not yet seen by the API
